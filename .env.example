# Copie para ".env" e preencha. NUNCA publique o arquivo .env.

# Porta e endereço público (HTTPS é obrigatório para microfone e notificações no iPhone)
PORT=3000
PUBLIC_URL=https://seu-dominio.exemplo
NODE_ENV=production
# Fuso padrão para novas contas
DEFAULT_TIMEZONE=America/Sao_Paulo
# Permitir novos cadastros depois do primeiro (o 1º usuário é sempre permitido)
ALLOW_SIGNUP=false

# IA (opcional) — sem chave, o app usa o interpretador local gratuito
ANTHROPIC_API_KEY=
# Modelo e esforço (padrões: claude-opus-5-5 / low). Para custo mínimo: AI_MODEL=claude-haiku-5-5
AI_MODEL=claude-opus-5-5
AI_EFFORT=low

# Transcrição de áudio no servidor (opcional; se vazio, usa o reconhecimento do próprio aparelho)
GROQ_API_KEY=
OPENAI_API_KEY=

# Contato exigido pelo protocolo Web Push (use seu e-mail ou site)
VAPID_SUBJECT=mailto:voce@exemplo.com
# Opcional: fixar as chaves VAPID (senão são geradas e guardadas em data/vapid.json)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
